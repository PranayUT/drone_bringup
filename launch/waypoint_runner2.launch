<?xml version="1.0"?>
<launch>
  <!--
    DJI waypoint loiter runner.

    Flies to each waypoint and circles around it. Orbit radius at each
    waypoint equals the drone's live height above takeoff.

    Requires dji_sdk to be running (sdk.launch) before launching this node.

    Usage:
      roslaunch drone_bringup waypoint_runner2.launch waypoints_file:=/path/to/waypoints.txt
  -->

  <arg name="waypoints_file"/>

  <arg name="speed"   default="5.0"/>
  <arg name="loiter"  default="10.0"/>

  <node pkg="drone_bringup"
        type="waypoint_runner2.py"
        name="waypoint_runner2"
        output="screen"
        launch-prefix="bash -c 'sleep 5; exec &quot;$@&quot;' --"
        args="$(arg waypoints_file) --speed $(arg speed) --loiter $(arg loiter)"/>
</launch>
